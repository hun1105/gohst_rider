# Unity
PhysicalAI_AGV_VR/[Ll]ibrary/
PhysicalAI_AGV_VR/[Tt]emp/
PhysicalAI_AGV_VR/[Oo]bj/
PhysicalAI_AGV_VR/[Bb]uild/
PhysicalAI_AGV_VR/[Bb]uilds/
PhysicalAI_AGV_VR/[Ll]ogs/
PhysicalAI_AGV_VR/[Uu]ser[Ss]ettings/
*.csproj
*.sln
*.apk
*.aab

# Python
__pycache__/
*.pyc
.venv/

# YOLO 가중치 (용량 큼 → 별도 보관)
*.pt
*.onnx

# 에이전트
.agent_cache/
.env

# 제출 패키지 산출물
dist/

# 문서 빌드 의존성
node_modules/

# 릴레이 운행 이력 (현장 기록, 제출 시 필요한 것만 docs로 발췌)
ai_relay_server/logs/

# 비밀정보 (Wi-Fi·SSH 평문) — 커밋·배포 금지
docs/handoff/*HANDOVER*.md

# Unity가 중복 생성한 빈 폴더 메타 (XR 1, Settings 1 …)
PhysicalAI_AGV_VR/Assets/XR [0-9]*
PhysicalAI_AGV_VR/Assets/XR/Settings [0-9]*

# 참고 논문 PDF·백업 압축 (저작권·용량)
hardware_firmware/**/*.pdf
hardware_firmware/*.zip

# 패키징 비밀정보 검사용 로컬 패턴 (실제 비밀번호 포함)
tools/secret_patterns.local.txt
